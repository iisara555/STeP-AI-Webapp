# Copy to ~/step-ai-gateway/ai-gateway.env (chmod 600). No key goes in this file: put the OpenRouter key in its own
# file (chmod 600) and point OPENROUTER_API_KEY_FILE at it.
STEP_DATA_ROOT=/data
STEP_INVITES_FILE=/data/invites.txt
STEP_AI_GATEWAY_CONFIG=/data/ai-gateway.json
OPENROUTER_API_KEY_FILE=/run/secrets/openrouter-key
# Web app client id and STeP Desktop installed-app client id, comma separated
STEP_GOOGLE_CLIENT_IDS=web-client.apps.googleusercontent.com,desktop-client.apps.googleusercontent.com
STEP_ALLOWED_DOMAINS=example.org
STEP_ADMINS=admin@example.org
# Same random value (32+ characters) in the Cloud Workspace Gateway's environment; lets its runtimes call this gateway
STEP_AI_INTERNAL_SECRET=
STEP_AI_GATEWAY_HOST=127.0.0.1
STEP_AI_GATEWAY_PORT=8788
