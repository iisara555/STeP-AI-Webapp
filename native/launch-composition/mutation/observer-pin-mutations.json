[
  {
    "id": "PO1",
    "desc": "hook: used marker removed (-g0 hooked object then has no hook name)",
    "file": "systemd-observer.c",
    "build": ["make", "-s", "systemd-observer.o"],
    "run": ["make", "-s", "pin-check-phony"],
    "after_find": "__attribute__((used)) static const char lso_test_hook_marker[]=\"lso_test_hook_marker\";\n",
    "after_repl": ""
  },
  {
    "id": "PO2",
    "desc": "hook: #error weakened to #warning (still fails only under -Werror)",
    "file": "systemd-observer.c",
    "build": ["make", "-s", "systemd-observer.o"],
    "run": ["make", "-s", "pin-check-phony"],
    "after_find": "#error \"LSO_TESTING is only valid",
    "after_repl": "#warning \"LSO_TESTING is only valid"
  },
