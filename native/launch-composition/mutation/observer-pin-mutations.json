    "build": ["make", "-s", "systemd-observer.o"],
    "run": ["make", "-s", "pin-check-phony"],
    "after_find": "case $symbols in *lso_test_*) refuse 'test hook symbol' ;; esac\n",
    "after_repl": ""
  },
